{
  "manifest_version": 3,
  "name": "Coach Manager CBTuró · FCBQ",
  "version": "1.10.0",
  "description": "Botón «Actualizar desde la FCBQ» de Coach Manager CBTuró: trae partidos, resultados y clasificaciones de basquetcatala.cat.",
  "permissions": [
    "scripting",
    "tabs",
    "alarms",
    "storage"
  ],
  "host_permissions": [
    "https://www.basquetcatala.cat/*",
    "https://*.basquetcatala.cat/*",
    "https://*.optimalwayconsulting.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://turo-coach1.vercel.app/*",
        "https://coach.cbturo.com/*",
        "https://cbturo.com/coach/*",
        "https://www.cbturo.com/coach/*",
        "http://localhost:3000/*"
      ],
      "js": [
        "puente.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.basquetcatala.cat/*",
        "https://*.basquetcatala.cat/*",
        "https://*.optimalwayconsulting.com/*"
      ],
      "js": [
        "captura.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "minimum_chrome_version": "111"
}